{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubedocs.nizmitz.com/schema/annotations.schema.json",
  "title": "kube-docs-mcp curated annotations catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "license", "attribution", "entries"],
  "properties": {
    "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "applies_to", "description", "doc_url"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9A-Z._/{}-]+$" },
          "type": { "enum": ["annotation", "label", "taint"], "default": "annotation" },
          "applies_to": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "value_type": { "type": "string", "description": "free text: string | bool | json | enum | int | duration" },
          "allowed_values": { "type": "array", "items": { "type": "string" } },
          "example": { "type": "string" },
          "description": { "type": "string", "minLength": 10 },
          "doc_url": { "type": "string", "format": "uri" },
          "since": { "type": "string" },
          "deprecated": { "type": ["boolean", "string"], "default": false }
        }
      }
    }
  }
}
